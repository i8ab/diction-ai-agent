# ===== LLM Keys (use at least one; more = automatic fallback) =====
GROQ_API_KEY=your_groq_key_here
GEMINI_API_KEY=your_gemini_key_here
OPENROUTER_API_KEY=

# Primary provider if LLM_FALLBACK_CHAIN is empty: groq | gemini | openrouter
LLM_PROVIDER=groq

# Ordered fallback chain (recommended)
# Example: try Groq first, then Gemini, then OpenRouter
LLM_FALLBACK_CHAIN=groq,gemini,openrouter

# Models (optional overrides)
# NOTE: GROQ_MODEL is not currently read anywhere in llm.py (only
# GROQ_FALLBACK_MODEL is used, by _call_groq) — kept here for future use.
# Groq deprecated llama-3.1-8b-instant and llama-3.3-70b-versatile; their
# recommended replacements are openai/gpt-oss-20b and openai/gpt-oss-120b.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.6-flash
OPENROUTER_MODEL=google/gemini-3.6-flash
OPENROUTER_REFERER=https://test-diction.vercel.app
OPENROUTER_TITLE=Bacaloria Study Coach

# Security
API_SECRET=change_this_to_a_random_secret

# Optional
SUPABASE_URL=
SUPABASE_KEY=
